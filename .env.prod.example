# Produccion: cp .env.prod.example .env y completa TODO. No lo subas al repositorio.

COMPOSE_PATH_SEPARATOR=;
COMPOSE_FILE=docker-compose.yml;docker-compose.prod.yml

# Contrasenas y secretos largos y aleatorios, por ejemplo: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
SESSION_SECRET=
# Cambiarlo despues de recolectar datos invalida los ids anonimos anteriores
ID_SALT=

# URL publica del sitio, sin barra final. Sin dominio: http://IP-DEL-SERVIDOR
PUBLIC_URL=
# Sin dominio: dejar ":80". Con dominio: el dominio (Caddy activa HTTPS solo) y COOKIE_SECURE=true
SITE_ADDRESS=:80
COOKIE_SECURE=false
#HTTP_PORT=80
#HTTPS_PORT=443

# SAML propio del servidor (sistemas@ucol.mx). Si se dejan vacios se usan los de DESARROLLO,
# que solo funcionan con callback en localhost:4006 y no sirven para usuarios remotos.
#SAML_ISSUER=
#SAML_CALLBACK_URL=
#SAML_LOGOUT_CALLBACK_URL=
#SAML_CERT_HOST_DIR=/opt/ecocampus/cert
#SAML_CLOCK_SKEW_MS=

#EXPERIMENTO_ACTIVO=true
