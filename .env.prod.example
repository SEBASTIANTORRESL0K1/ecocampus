# Produccion: cp .env.prod.example .env y completa TODO. No lo subas al repositorio.
# El compose no tiene valores por defecto: TODA variable debe estar aqui, o docker compose se detiene.

# --- Archivos de compose (base + produccion) ---
COMPOSE_PATH_SEPARATOR=;
COMPOSE_FILE=docker-compose.yml;docker-compose.prod.yml

# --- MySQL: contrasenas largas y aleatorias, por ejemplo: openssl rand -hex 32 ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=ecocampus
MYSQL_USER=ecocampus
MYSQL_PASSWORD=
# Nombre del servicio y puerto de MySQL dentro de la red de Docker
DB_HOST=db
DB_PORT=3306

# --- Backend ---
NODE_ENV=production
SESSION_SECRET=
# Cambiarlo despues de recolectar datos invalida los ids anonimos anteriores
ID_SALT=
REQUIERE_LOGIN=true
# URL publica de la calculadora. Sin dominio: http://IP-DEL-SERVIDOR/ecocampus/calculadora
FRONTEND_URL=
# true solo cuando el sitio se sirva por HTTPS (con dominio); con HTTP las cookies de sesion no se guardarian
COOKIE_SECURE=false
# El backend va detras de Caddy
TRUST_PROXY=true

# --- SAML del servidor (se tramitan con sistemas@ucol.mx) ---
# Mientras no los tengas puedes poner los de desarrollo del asesor, pero solo funcionan con callback
# en localhost:4006 y NO sirven para usuarios remotos (el backend lo avisa en sus logs).
SAML_ISSUER=
# Rutas del propio sitio, que Caddy reenvia al backend: https://TU-DOMINIO/login/callback y /logout/callback
SAML_CALLBACK_URL=
SAML_LOGOUT_CALLBACK_URL=
SAML_ENTRY_POINT=https://wayf.ucol.mx/saml2/idp/SSOService.php
SAML_LOGOUT_URL=https://wayf.ucol.mx/saml2/idp/SingleLogoutService.php
# Desfase real del reloj del IdP en ms; -1 desactiva la validacion de timestamps (menos seguro)
SAML_CLOCK_SKEW_MS=-1
# Carpeta del servidor con cert.pem, idp.crt y key.pem, fuera del repositorio. Ejemplo: /opt/ecocampus/cert
SAML_CERT_HOST_DIR=

# --- Frontend ---
# URL publica del sitio, sin barra final (el navegador llama a la API por el mismo origen). Ejemplo: https://TU-DOMINIO
API_URL=
EXPERIMENTO_ACTIVO=true

# --- Proxy (Caddy) ---
# Sin dominio: :80 (HTTP). Con dominio: el dominio y Caddy activa HTTPS solo (puertos 80 y 443 abiertos)
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
