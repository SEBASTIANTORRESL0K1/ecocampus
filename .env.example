# Copia este archivo a .env y completa los valores (docker compose lo lee solo).

MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Genera valores largos y aleatorios, por ejemplo: openssl rand -hex 32
SESSION_SECRET=
# Cambiarlo despues de recolectar datos invalida los ids anonimos anteriores
ID_SALT=

# URL publica del frontend y del backend (la ve el navegador).
# En local los valores por defecto sirven; en EC2 usa tu dominio o IP.
#FRONTEND_URL=http://localhost:8080/ecocampus/calculadora
#API_URL=http://localhost:4006

# Con HTTPS en produccion
#COOKIE_SECURE=true
#TRUST_PROXY=true
