# Variables del backend (uso fuera de Docker; con Docker se definen en el .env de la raiz).

# A donde regresa el usuario despues de iniciar sesion
FRONTEND_URL=http://localhost:5173/ecocampus/calculadora
SESSION_SECRET=
ID_SALT=

# MySQL
DB_HOST=localhost
DB_PORT=3307
DB_USER=ecocampus
DB_PASSWORD=
DB_NAME=ecocampus

