{
  "name": "ecocampus-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Servicio de login federado (SAML) de la Universidad de Colima para Ecocampus",
  "main": "dist/server.js",
  "scripts": {
    "start": "node --enable-source-maps dist/server.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "dev": "nodemon -L --watch src --ext ts,json --exec tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "openapi": "tsx src/openapi/generar.ts"
  },
  "dependencies": {
    "@node-saml/passport-saml": "^5.1.0",
    "cors": "^2.8.6",
    "dotenv": "16.0.0",
    "express": "^4.22.2",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "mysql2": "^3.24.6",
    "passport": "0.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-mysql-session": "^3.0.8",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.20.5",
    "@types/passport": "^1.0.17",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.14",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
