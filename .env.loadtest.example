# Pruebas de carga: cp .env.loadtest.example .env.loadtest
# El compose no tiene valores por defecto: TODA variable debe estar aqui, o docker compose se detiene.
# Estos valores NO son secretos; sirven solo para tu maquina.

# --- Archivos de compose (base + desarrollo) ---
# (sin COMPOSE_FILE: los archivos se pasan con -f)

# --- MySQL ---
MYSQL_ROOT_PASSWORD=dev-root-password
MYSQL_DATABASE=ecocampus
MYSQL_USER=ecocampus
MYSQL_PASSWORD=dev-password
# Conexion del backend, herramientas incluidas (nombre del servicio y puerto dentro de la red de Docker)
DB_HOST=db
DB_PORT=3306

# --- Backend ---
NODE_ENV=production
SESSION_SECRET=dev-session-secret-no-usar-en-produccion
# Cambiarlo despues de recolectar datos invalida los ids anonimos anteriores
ID_SALT=dev-id-salt-no-usar-en-produccion
# false permite guardar respuestas sin sesion SAML (solo pruebas)
REQUIERE_LOGIN=false
# A donde regresa el usuario despues de iniciar sesion
FRONTEND_URL=http://localhost:5173/ecocampus/calculadora
COOKIE_SECURE=false
TRUST_PROXY=false

# --- SAML: valores de desarrollo que entrego el asesor (UCOL). Solo funcionan con callback en localhost:4006 ---
SAML_ISSUER=http://localhost/20166932
SAML_CALLBACK_URL=http://localhost:4006/login/callback
SAML_LOGOUT_CALLBACK_URL=http://localhost:4006/logout/callback
SAML_ENTRY_POINT=https://wayf.ucol.mx/saml2/idp/SSOService.php
SAML_LOGOUT_URL=https://wayf.ucol.mx/saml2/idp/SingleLogoutService.php
# -1 desactiva la validacion de timestamps (desfase de reloj del IdP de la UCOL)
SAML_CLOCK_SKEW_MS=-1

# --- Frontend (URL del backend que ve el navegador) ---
API_URL=http://localhost:4006
EXPERIMENTO_ACTIVO=true
# Con el codigo montado desde Windows no llegan eventos de archivos: Vite usa polling
VITE_USE_POLLING=true



