# Desarrollo local: cp .env.dev.example .env   (docker compose up --build)
# Estos valores NO son secretos; sirven solo para tu maquina.

COMPOSE_PATH_SEPARATOR=;
COMPOSE_FILE=docker-compose.yml;docker-compose.dev.yml

MYSQL_ROOT_PASSWORD=dev-root-password
MYSQL_PASSWORD=dev-password
SESSION_SECRET=dev-session-secret-no-usar-en-produccion
ID_SALT=dev-id-salt-no-usar-en-produccion

# Opcionales (valores por defecto entre parentesis)
#FRONTEND_URL=http://localhost:5173/ecocampus/calculadora
#API_URL=http://localhost:4006
#EXPERIMENTO_ACTIVO=true
