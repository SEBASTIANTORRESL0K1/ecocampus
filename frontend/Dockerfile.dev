# Desarrollo: servidor de Vite con recarga en vivo. El codigo se monta como volumen
# (docker-compose.dev.yml); aqui solo se instalan las dependencias.
FROM node:20-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
